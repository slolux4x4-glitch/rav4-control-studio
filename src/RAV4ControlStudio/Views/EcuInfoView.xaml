<UserControl x:Class="RAV4ControlStudio.Views.EcuInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <DockPanel Margin="6">
    <c:PageHeader DockPanel.Dock="Top" Title="ECU Information" Subtitle="Vehicle, engine ECU and adapter identity as reported over the OBD-II link."/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Image Source="/Assets/icons/st_ecu.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Vehicle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ActionButton}" Margin="0" Padding="12,7" Command="{Binding CopyVinCommand}" Content="Copy VIN"/>
                    </DockPanel>
                    <Border Height="110" CornerRadius="8" ClipToBounds="True" Background="#080E15" Margin="0,0,0,10">
                        <Image Source="/Assets/car.png" Stretch="Uniform" HorizontalAlignment="Right" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Model" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding VehicleTitle}" FontSize="15" TextWrapping="Wrap" FontWeight="SemiBold"/></Grid></Border><Border Grid.Row="1" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Model year" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding VinYearText}" FontSize="15" TextWrapping="Wrap" /></Grid></Border><Border Grid.Row="2" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Manufacturer" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding VinMakerText}" FontSize="15" TextWrapping="Wrap" /></Grid></Border><Border Grid.Row="3" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="VIN" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding VinText}" FontSize="15" TextWrapping="Wrap" FontFamily="Consolas" FontWeight="SemiBold"/></Grid></Border><Border Grid.Row="4" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Serial (VIN sequence)" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding VinSerialText}" FontSize="15" TextWrapping="Wrap" FontFamily="Consolas"/></Grid></Border><Border Grid.Row="5" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="World maker ID (WMI)" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding VinWmiText}" FontSize="15" TextWrapping="Wrap" FontFamily="Consolas"/></Grid></Border><Border Grid.Row="6" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Vehicle descriptor" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding VinDescriptorText}" FontSize="15" TextWrapping="Wrap" FontFamily="Consolas"/></Grid></Border><Border Grid.Row="7" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Plant code" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding VinPlantText}" FontSize="15" TextWrapping="Wrap" FontFamily="Consolas"/></Grid></Border><Border Grid.Row="8" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Check digit" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding VinDetails}" FontSize="15" TextWrapping="Wrap" /></Grid></Border></Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Image Source="/Assets/icons/st_ecu.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Engine ECU (ECM)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <Border Height="110" CornerRadius="8" Background="#080E15" Margin="0,0,0,10">
                        <Image Source="/Assets/ecu.png" Height="90" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="ECU name" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding EcuNameText}" FontSize="15" TextWrapping="Wrap" FontWeight="SemiBold"/></Grid></Border><Border Grid.Row="1" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Calibration ID" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding CalibrationIdText}" FontSize="15" TextWrapping="Wrap" FontFamily="Consolas"/></Grid></Border><Border Grid.Row="2" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="CVN" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding CvnText}" FontSize="15" TextWrapping="Wrap" FontFamily="Consolas"/></Grid></Border><Border Grid.Row="3" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Protocol" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding ProtocolText}" FontSize="15" TextWrapping="Wrap" /></Grid></Border><Border Grid.Row="4" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Mode 09 info types" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding InfoTypesText}" FontSize="15" TextWrapping="Wrap" FontFamily="Consolas"/></Grid></Border><Border Grid.Row="5" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Detected" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding EcuSummary}" FontSize="15" TextWrapping="Wrap" /></Grid></Border></Grid>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"
                               Text="OBD-II has no standard ECU serial number. The calibration ID and CVN identify the ECU software; the vehicle serial is the VIN production sequence."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Image Source="/Assets/icons/st_usb.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="OBD2 adapter" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Description" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding AdapterDescriptionText}" FontSize="15" TextWrapping="Wrap" /></Grid></Border><Border Grid.Row="1" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Version" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding AdapterVersionText}" FontSize="15" TextWrapping="Wrap" /></Grid></Border><Border Grid.Row="2" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Serial / ID" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding AdapterSerialText}" FontSize="15" TextWrapping="Wrap" FontFamily="Consolas"/></Grid></Border><Border Grid.Row="3" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Supply voltage" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding AdapterVoltageText}" FontSize="15" TextWrapping="Wrap" /></Grid></Border><Border Grid.Row="4" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Link" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="{Binding ConnectionText}" FontSize="15" TextWrapping="Wrap" /></Grid></Border></Grid>
                    <Button Style="{StaticResource ActionButton}" Command="{Binding CopyIdentityCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" Content="Copy all information"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Image Source="/Assets/icons/sec_live.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Supported parameters (Mode 01)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <ItemsControl ItemsSource="{Binding SupportedPidItems}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141F2B" CornerRadius="6" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" Foreground="#CBD5DF"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
    </DockPanel>
</UserControl>
