<UserControl x:Class="RAV4ControlStudio.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <DockPanel Margin="6">
    <c:PageHeader DockPanel.Dock="Top" Title="Diagnostics (DTCs)" Subtitle="Read fault codes from the ECU and look them up in the offline code database."/>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.35*"/>
        </Grid.ColumnDefinitions>

        <!-- Summary -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource Card}" Background="#0D1721">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/icons/dtc_ok.png" Width="58" Height="58" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DtcHeadline}" FontSize="26" FontWeight="SemiBold" Foreground="{Binding DtcStateBrush}"/>
                    <TextBlock Text="{Binding DtcSubtext}" Style="{StaticResource Muted}" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Background="#141F2B" CornerRadius="8" Padding="16,8" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="Malfunction lamp" Foreground="#9AA8B6" FontSize="12"/><TextBlock Text="{Binding MilText}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                    <Border Background="#141F2B" CornerRadius="8" Padding="16,8">
                        <StackPanel><TextBlock Text="Stored count" Foreground="#9AA8B6" FontSize="12"/><TextBlock Text="{Binding DtcCount}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource LargeButton}" Command="{Binding RefreshDiagnosticsCommand}">
                    <StackPanel Orientation="Horizontal"><Image Source="/Assets/icons/btn_refresh.png" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Read codes" FontSize="17" VerticalAlignment="Center"/></StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Codes read from the ECU -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8"><Image Source="/Assets/icons/sec_diag.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Codes from the ECU" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                           Text="Select a code to see its entry in the database. Codes are read only; this app never clears them."/>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Stored (Mode 03)" Foreground="#9AA8B6" Margin="0,0,0,4"/>
                        <Grid><DataGrid ItemsSource="{Binding StoredDtcs}" SelectedItem="{Binding SelectedReadDtc, Mode=TwoWay}" FontSize="14" RowHeight="30">
                            <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1C2A38"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
                    </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid><TextBlock Text="No stored codes" Foreground="#6F7E8D" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding StoredDtcs.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Pending (Mode 07)" Foreground="#9AA8B6" Margin="0,0,0,4"/>
                        <Grid><DataGrid ItemsSource="{Binding PendingDtcs}" SelectedItem="{Binding SelectedReadDtc, Mode=TwoWay}" FontSize="14" RowHeight="30">
                            <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1C2A38"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
                    </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid><TextBlock Text="No pending codes" Foreground="#6F7E8D" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PendingDtcs.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                    </DockPanel>
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Permanent (Mode 0A)" Foreground="#9AA8B6" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding PermanentDtcs}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,4" Foreground="{StaticResource WarnBrush}" Content="{Binding Code}" ToolTip="{Binding Description}"
                                        Command="{Binding DataContext.OpenDtcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="None reported" Foreground="#6F7E8D" FontSize="14">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PermanentDtcs.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Code database -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
            <DockPanel>
                <!-- Title on its own line; the view switch on the left and the code-list tools on the right below it -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><Image Source="/Assets/icons/sec_can.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Trouble Code Database" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <RadioButton DockPanel.Dock="Left" GroupName="DiagTab" Style="{StaticResource TabRadio}" Content="Code database" IsChecked="{Binding ShowDatabase}" VerticalAlignment="Center"/>
                    <RadioButton DockPanel.Dock="Left" GroupName="DiagTab" Style="{StaticResource TabRadio}" Content="Freeze frame" IsChecked="{Binding ShowFreezeFrame}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding ReloadCodesCommand}" Content="Reload"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="0" Command="{Binding OpenCodesFolderCommand}" Content="Import codes..." ToolTip="Open the folder for your own .json or .csv code lists"/>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Text="{Binding DtcSearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="12,9" Background="#0E161F" BorderBrush="#1E2E3D" Foreground="White" CaretBrush="White"/>
                        <TextBlock Text="Search by code or words, e.g. P0420 or misfire" IsHitTestVisible="False" Foreground="#5D6B7A" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DtcSearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding DtcCategories}" SelectedItem="{Binding SelectedDtcCategory}" Padding="10,9"/>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="{Binding DtcDatabaseSummary}" Foreground="#9AA8B6" FontSize="12" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                <Border DockPanel.Dock="Bottom" Background="#0E161F" CornerRadius="8" Padding="16,12" Margin="0,10,0,0" MinHeight="110" MaxHeight="210">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DtcDetailTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <TextBlock Text="{Binding DtcDetailText}" TextWrapping="Wrap" FontSize="14" Foreground="#CBD5DF"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <DataGrid ItemsSource="{Binding DtcResults}" SelectedItem="{Binding SelectedDtcEntry, Mode=TwoWay}" FontSize="14" RowHeight="30">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1C2A38"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <Border Margin="0,46,0,0" Background="{StaticResource CardBrush}"
                    Visibility="{Binding ShowFreezeFrame, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding FreezeTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,2,0,8"
                               Text="Sensor values the ECU stored at the moment the fault was set. They help show the conditions when it happened."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FreezeRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="15"/>
                                            <TextBlock Text="{Binding ResultText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
</UserControl>
