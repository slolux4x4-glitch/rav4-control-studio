<UserControl x:Class="RAV4ControlStudio.Views.DiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <DockPanel Margin="6">
        <c:PageHeader DockPanel.Dock="Top" Title="ECU Discovery" Subtitle="Find which control units answer on the diagnostic bus and read their identification data."/>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ActionButton}" Margin="0,0,8,0" Padding="22,10" FontSize="15" Command="{Binding ScanEcusCommand}" Content="Scan for ECUs"/>
                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Margin="0,0,16,0" Padding="18,10" FontSize="15" Command="{Binding CancelScanCommand}" Content="Cancel"/>
                <CheckBox Grid.Column="2" VerticalAlignment="Center" FontSize="14" IsChecked="{Binding ScanFull}" Content="Full scan (0x700 to 0x7EF, slower)"/>
                <TextBlock Grid.Column="3" Text="{Binding ScanStatus}" Foreground="#9AA8B6" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Background="#0E1C17" BorderBrush="#1F6A3C" Padding="16,10">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource GoodBrush}" FontSize="13">
                <Run FontWeight="SemiBold" Text="Read-only. "/>
                <Run Text="The scan sends only 'tester present' and standard identification reads. Nothing is written to any ECU. Changing dealer options (customisation settings) is not possible from this app."/>
            </TextBlock>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding EcuNodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6">
                                    <Run Text="ECU "/><Run Text="{Binding RequestHex, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                                    <Run Text="  replies from " Foreground="#9AA8B6" FontSize="14"/><Run Text="{Binding ResponseHex, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontSize="14"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" Foreground="#9AA8B6" FontSize="14"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
