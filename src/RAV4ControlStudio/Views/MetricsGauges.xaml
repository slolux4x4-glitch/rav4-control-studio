<UserControl x:Class="RAV4ControlStudio.Views.MetricsGauges"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <!-- The four Metrics dials. Shared by the Metrics page and the full-screen view so both always match. -->
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2"><Image Source="{StaticResource IconSpeed}" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Vehicle Speed" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding PeakSpeedText}" Foreground="#C9D6E2" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,4"/><c:GaugeControl MinHeight="200" Margin="0,8" Value="{Binding SpeedShown, Mode=OneWay}" Minimum="0" Maximum="{Binding SpeedGaugeMax}" MajorStep="{Binding SpeedGaugeStep}" Unit="{Binding SpeedUnitText}" ValueFormat="0" Accent="{StaticResource AccentBrush}"/></DockPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2"><Image Source="{StaticResource IconEngine}" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Engine Speed" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding PeakRpmText}" Foreground="#C9D6E2" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,4"/><c:GaugeControl MinHeight="200" Margin="0,8" Value="{Binding Rpm.Value, Mode=OneWay}" Minimum="0" Maximum="7000" MajorStep="500" LabelDivisor="1000" LabelFormat="0.0" Caption="×1000 rpm" WarningFrom="5500" DangerFrom="6500" Unit="rpm" ValueFormat="0" Accent="{StaticResource AccentBrush}"/></DockPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2"><Image Source="{StaticResource IconCoolant}" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Coolant (Water) Temp" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding PeakCoolantText}" Foreground="#C9D6E2" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,4"/><c:GaugeControl MinHeight="200" Margin="0,8" Value="{Binding CoolantShown, Mode=OneWay}" Minimum="{Binding TempGaugeMin}" Maximum="{Binding TempGaugeMax}" MajorStep="{Binding TempGaugeStep}" WarningFrom="{Binding TempWarnFrom}" DangerFrom="{Binding TempDangerFrom}" Icon="{StaticResource IconCoolant}" Unit="{Binding TempUnitText}" ValueFormat="0" Accent="#22C7F0"/></DockPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2"><Image Source="{StaticResource IconBattery}" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Battery Voltage" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding VoltageRangeText}" Foreground="#C9D6E2" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,4"/><c:GaugeControl MinHeight="200" Margin="0,8" Value="{Binding Voltage.Value, Mode=OneWay}" Minimum="11" Maximum="16" MajorStep="0.5" LabelFormat="0.0" Unit="V" ValueFormat="0.0" Accent="{StaticResource GoodBrush}"/></DockPanel></Border>
    </Grid>
</UserControl>
