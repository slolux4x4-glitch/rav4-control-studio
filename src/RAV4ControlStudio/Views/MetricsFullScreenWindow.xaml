<Window x:Class="RAV4ControlStudio.Views.MetricsFullScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RAV4ControlStudio.Views"
        Title="Metrics (full screen)" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="{StaticResource BgBrush}" Cursor="None">
    <Grid Margin="24">
        <!-- Scaled up on large screens so titles and peak values grow with the dials -->
        <local:MetricsGauges x:Name="Gauges"/>

        <!-- Shown for a few seconds, then fades away -->
        <Border x:Name="Hint" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                Background="#CC0D1620" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,9"
                IsHitTestVisible="False">
            <TextBlock Text="Press any key or click to exit full screen" FontSize="16" Foreground="#C9D6E2"/>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:3" Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>
    </Grid>
</Window>
