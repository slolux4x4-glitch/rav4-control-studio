<UserControl x:Class="RAV4ControlStudio.Views.TestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>

        <c:PageHeader Grid.ColumnSpan="2" Title="Tests (Read-Only)" Subtitle="Emissions I/M readiness: whether each self-test has run since codes were last cleared."/>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Summary" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{Binding ReadinessHeadline}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ReadinessTimestamp}" Style="{StaticResource Muted}" Margin="0,4,0,18"/>

                <Border Padding="14" CornerRadius="10" Background="#0E161F" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="14"><Run Text="Malfunction indicator: "/><Run Text="{Binding MilText, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        <TextBlock FontSize="14" Margin="0,8,0,0"><Run Text="Stored DTC count: "/><Run Text="{Binding DtcCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        <TextBlock FontSize="14" Margin="0,8,0,0"><Run Text="Ignition type: "/><Run Text="{Binding IgnitionText, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0" TextWrapping="Wrap">
                    A "Not ready" result after a battery disconnect or a code clear is normal. Drive a few cycles, then press Refresh on the Diagnostics page.
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Monitors" Style="{StaticResource CardTitle}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="230" Margin="6" Padding="16,14" CornerRadius="10"
                                        Background="#0E161F" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
