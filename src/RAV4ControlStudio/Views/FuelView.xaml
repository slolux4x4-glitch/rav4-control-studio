<UserControl x:Class="RAV4ControlStudio.Views.FuelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <DockPanel Margin="6">
        <c:PageHeader DockPanel.Dock="Top" Title="Fuel and O2" Subtitle="Fuel trims, oxygen sensors, air-fuel ratio and catalyst temperature, with plain-language hints."/>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding FuelItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Pid.Name}" Foreground="#9AA8B6" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Pid.Display}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.9*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Last three minutes (each line scaled to its own range)" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <c:NormalizedChart x:Name="Chart"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="What the numbers suggest" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Fuel trims" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding FuelTrimAssessment}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,12"/>
                        <TextBlock Text="Air-fuel ratio" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding LambdaAssessment}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,12"/>
                        <TextBlock Text="Catalyst" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding CatalystText}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,12"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                   Text="These hints are general guidance from typical ranges. They cannot replace a proper diagnosis."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
