<UserControl x:Class="RAV4ControlStudio.Views.SupportedPidsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <!-- Not in the sidebar: opened from ECU Information > Supported parameters, with Back to return. -->
    <DockPanel Margin="6">
        <DockPanel DockPanel.Dock="Top" Margin="8,4,8,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0" Command="{Binding ShowEcuInfoCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;" Margin="0,0,8,0"/>
                    <TextBlock Text="Back to ECU Information" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <c:PageHeader Margin="0" Title="Supported parameters (Mode 01)"
                          Subtitle="Live values the engine ECU says it can report. The app reads only these."/>
        </DockPanel>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,12">
                    <Run Text="{Binding SupportedPidItems.Count, Mode=OneWay}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/><Run Text=" parameters reported by the ECU (the list fills when you connect)."/>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SupportedPidItems}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141F2B" CornerRadius="6" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" Foreground="#CBD5DF"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
