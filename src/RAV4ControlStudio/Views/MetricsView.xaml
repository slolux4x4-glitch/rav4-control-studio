<UserControl x:Class="RAV4ControlStudio.Views.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="8,4,8,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0"
                    Command="{Binding ToggleUnitsCommand}" Content="{Binding UnitsButtonText}"/>
            <c:PageHeader Margin="0" Title="Metrics" Subtitle="Speed, engine speed, coolant (water) temperature and battery voltage, live from the ECU."/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2"><Image Source="/Assets/icons/g_throttle.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Vehicle Speed" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding PeakSpeedText}" Foreground="#C9D6E2" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,4"/><c:GaugeControl MinHeight="200" Margin="0,8" Value="{Binding SpeedShown, Mode=OneWay}" Minimum="0" Maximum="{Binding SpeedGaugeMax}" MajorStep="{Binding SpeedGaugeStep}" Unit="{Binding SpeedUnitText}" ValueFormat="0" Accent="{StaticResource AccentBrush}"/></DockPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2"><Image Source="/Assets/icons/g_rpm.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Engine Speed" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding PeakRpmText}" Foreground="#C9D6E2" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,4"/><c:GaugeControl MinHeight="200" Margin="0,8" Value="{Binding Rpm.Value, Mode=OneWay}" Minimum="0" Maximum="7000" MajorStep="500" LabelDivisor="1000" LabelFormat="0.0" Caption="×1000 rpm" WarningFrom="5500" DangerFrom="6500" Unit="rpm" ValueFormat="0" Accent="{StaticResource AccentBrush}"/></DockPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2"><Image Source="/Assets/icons/g_temp.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Coolant (Water) Temp" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding PeakCoolantText}" Foreground="#C9D6E2" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,4"/><c:GaugeControl MinHeight="200" Margin="0,8" Value="{Binding CoolantShown, Mode=OneWay}" Minimum="{Binding TempGaugeMin}" Maximum="{Binding TempGaugeMax}" MajorStep="{Binding TempGaugeStep}" WarningFrom="{Binding TempWarnFrom}" DangerFrom="{Binding TempDangerFrom}" Icon="/Assets/icons/g_temp.png" Unit="{Binding TempUnitText}" ValueFormat="0" Accent="#22C7F0"/></DockPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2"><Image Source="/Assets/icons/g_batt.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Battery Voltage" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding VoltageRangeText}" Foreground="#C9D6E2" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,4"/><c:GaugeControl MinHeight="200" Margin="0,8" Value="{Binding Voltage.Value, Mode=OneWay}" Minimum="11" Maximum="16" MajorStep="0.5" LabelFormat="0.0" Unit="V" ValueFormat="0.0" Accent="{StaticResource GoodBrush}"/></DockPanel></Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Throttle position" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding Throttle.Display}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/><ProgressBar Height="4" Minimum="{Binding Throttle.Min, Mode=OneWay}" Maximum="{Binding Throttle.Max, Mode=OneWay}" Value="{Binding Throttle.Value, Mode=OneWay, FallbackValue=0}" Foreground="{StaticResource AccentBrush}" Background="#1E2E3D" BorderThickness="0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Engine load" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding Load.Display}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/><ProgressBar Height="4" Minimum="{Binding Load.Min, Mode=OneWay}" Maximum="{Binding Load.Max, Mode=OneWay}" Value="{Binding Load.Value, Mode=OneWay, FallbackValue=0}" Foreground="{StaticResource AccentBrush}" Background="#1E2E3D" BorderThickness="0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Intake air temp" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding IntakeTempText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/><ProgressBar Height="4" Minimum="{Binding IntakeTemp.Min, Mode=OneWay}" Maximum="{Binding IntakeTemp.Max, Mode=OneWay}" Value="{Binding IntakeTemp.Value, Mode=OneWay, FallbackValue=0}" Foreground="{StaticResource AccentBrush}" Background="#1E2E3D" BorderThickness="0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Fuel level" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding FuelLevel.Display}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/><ProgressBar Height="4" Minimum="{Binding FuelLevel.Min, Mode=OneWay}" Maximum="{Binding FuelLevel.Max, Mode=OneWay}" Value="{Binding FuelLevel.Value, Mode=OneWay, FallbackValue=0}" Foreground="{StaticResource AccentBrush}" Background="#1E2E3D" BorderThickness="0"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Fuel economy (est.)" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding FuelEconomyText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,6" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            <Border Grid.Column="5" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Trip average (est.)" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding TripEconomyText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,6" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
