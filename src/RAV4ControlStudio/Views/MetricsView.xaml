<UserControl x:Class="RAV4ControlStudio.Views.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls"
             xmlns:local="clr-namespace:RAV4ControlStudio.Views">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="8,4,8,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Click="FullScreen_Click"
                    ToolTip="Show the dials full screen. Press any key or click to exit.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE740;" Margin="0,0,8,0"/>
                    <TextBlock Text="Full screen" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0"
                    Command="{Binding ToggleUnitsCommand}" Content="{Binding UnitsButtonText}"/>
            <c:PageHeader Margin="0" Title="Metrics" Subtitle="Speed, engine speed, coolant (water) temperature and battery voltage, live from the ECU."/>
        </DockPanel>

        <local:MetricsGauges Grid.Row="1"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Throttle position" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding Throttle.Display}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/><ProgressBar Height="4" Minimum="{Binding Throttle.Min, Mode=OneWay}" Maximum="{Binding Throttle.Max, Mode=OneWay}" Value="{Binding Throttle.Value, Mode=OneWay, FallbackValue=0}" Foreground="{StaticResource AccentBrush}" Background="#1E2E3D" BorderThickness="0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Engine load" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding Load.Display}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/><ProgressBar Height="4" Minimum="{Binding Load.Min, Mode=OneWay}" Maximum="{Binding Load.Max, Mode=OneWay}" Value="{Binding Load.Value, Mode=OneWay, FallbackValue=0}" Foreground="{StaticResource AccentBrush}" Background="#1E2E3D" BorderThickness="0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Intake air temp" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding IntakeTempText}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/><ProgressBar Height="4" Minimum="{Binding IntakeTemp.Min, Mode=OneWay}" Maximum="{Binding IntakeTemp.Max, Mode=OneWay}" Value="{Binding IntakeTemp.Value, Mode=OneWay, FallbackValue=0}" Foreground="{StaticResource AccentBrush}" Background="#1E2E3D" BorderThickness="0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Fuel level" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding FuelLevel.Display}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/><ProgressBar Height="4" Minimum="{Binding FuelLevel.Min, Mode=OneWay}" Maximum="{Binding FuelLevel.Max, Mode=OneWay}" Value="{Binding FuelLevel.Value, Mode=OneWay, FallbackValue=0}" Foreground="{StaticResource AccentBrush}" Background="#1E2E3D" BorderThickness="0"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Fuel economy (est.)" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding FuelEconomyText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,6" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
            <Border Grid.Column="5" Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="Trip average (est.)" Foreground="#9AA8B6" FontSize="14"/><TextBlock Text="{Binding TripEconomyText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,6" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
