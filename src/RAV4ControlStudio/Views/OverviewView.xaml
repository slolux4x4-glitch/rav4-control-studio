<UserControl x:Class="RAV4ControlStudio.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <UserControl.Resources>
        <Style x:Key="CanText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D5DDE5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="186"/>
            <RowDefinition Height="204"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.45*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Background="#080E15">
            <Grid>
                <Image Source="/Assets/car.png" HorizontalAlignment="Right" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/><GradientStop Color="Black" Offset="0.25"/><GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <StackPanel VerticalAlignment="Center" Margin="30,0,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding VehicleTitle}" FontSize="31" FontWeight="SemiBold"/>
                    <TextBlock FontSize="17" Margin="0,12,0,0" Foreground="#CBD5DF"><Run Text="Engine: "/><Run Text="{Binding VehicleEngineText, Mode=OneWay}"/></TextBlock>
                    <TextBlock FontSize="17" Margin="0,4,0,0" Foreground="#CBD5DF"><Run Text="Transmission: "/><Run Text="{Binding VehicleTransmissionText, Mode=OneWay}"/></TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Background="#0D1721" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Image Source="/Assets/icons/st_ok.png" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{Binding SystemTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding ConnectionBrush}" VerticalAlignment="Center"/></StackPanel>
                    <Border Grid.Row="1" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/icons/st_usb.png" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{Binding InterfaceLabel}" FontSize="15" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding UsbStatusText}" FontSize="17" VerticalAlignment="Center" Foreground="{Binding UsbStatusBrush}"/></Grid></Border>
                    <Border Grid.Row="2" BorderBrush="#1A2836" BorderThickness="0,0,0,1" Padding="0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/icons/st_can.png" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="CAN Bus (ISO)" FontSize="15" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding CanStatusText}" FontSize="17" VerticalAlignment="Center" Foreground="{Binding CanStatusBrush}"/></Grid></Border>
                    <Border Grid.Row="3" BorderBrush="#1A2836" BorderThickness="0,0,0,0" Padding="0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/icons/st_ecu.png" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="ECU" FontSize="15" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding EcuStatusText}" FontSize="17" VerticalAlignment="Center" Foreground="{Binding EcuStatusBrush}"/></Grid></Border>
                </Grid>
                <Border Grid.Column="1" Width="1" Background="#1E2E3D" Margin="10,0"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Image Source="/Assets/ecu.png" Height="70" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border Background="#141F2B" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                        <StackPanel><TextBlock Text="Engine ECU (ECM)" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/><TextBlock Text="M20A-FKS / CVT" Foreground="#CBD5DF" FontSize="14" HorizontalAlignment="Center"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6"><Image Source="/Assets/icons/sec_live.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Live Data (Key Parameters)" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <UniformGrid Columns="4" VerticalAlignment="Center">
                    <StackPanel Margin="10,0"><c:GaugeControl Height="128" Value="{Binding Rpm.Value, Mode=OneWay}" Minimum="0" Maximum="7000" MajorStep="1000" Icon="{StaticResource IconEngine}" LabelDivisor="1000" LabelFormat="0" WarningFrom="5500" DangerFrom="6500" Unit="rpm" ValueFormat="0" Accent="{StaticResource AccentBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{StaticResource IconEngine}" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Engine Speed" FontSize="16" VerticalAlignment="Center"/></StackPanel></StackPanel>
                    <StackPanel Margin="10,0"><c:GaugeControl Height="128" Value="{Binding CoolantShown, Mode=OneWay}" Minimum="{Binding TempGaugeMin}" Maximum="{Binding TempGaugeMax}" MajorStep="{Binding TempGaugeStep}" WarningFrom="{Binding TempWarnFrom}" DangerFrom="{Binding TempDangerFrom}" Icon="{StaticResource IconCoolant}" Unit="{Binding TempUnitText}" ValueFormat="0" Accent="#22C7F0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{StaticResource IconCoolant}" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Coolant Temp" FontSize="16" VerticalAlignment="Center"/></StackPanel></StackPanel>
                    <StackPanel Margin="10,0"><c:GaugeControl Height="128" Value="{Binding Voltage.Value, Mode=OneWay}" Minimum="11" Maximum="16" MajorStep="1" Icon="{StaticResource IconBattery}" Unit="V" ValueFormat="0.0" Accent="{StaticResource GoodBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{StaticResource IconBattery}" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Battery Voltage" FontSize="16" VerticalAlignment="Center"/></StackPanel></StackPanel>
                    <StackPanel Margin="10,0"><c:GaugeControl Height="128" Value="{Binding Throttle.Value, Mode=OneWay}" Minimum="0" Maximum="100" MajorStep="20" Icon="{StaticResource IconSpeed}" Unit="%" ValueFormat="0" Accent="{StaticResource GreyBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{StaticResource IconSpeed}" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Throttle Position" FontSize="16" VerticalAlignment="Center"/></StackPanel></StackPanel>
                </UniformGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6"><Image Source="/Assets/icons/sec_diag.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Diagnostics (DTCs)" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                    <Button Style="{StaticResource ActionButton}" Margin="0,0,5,0" Command="{Binding ShowDiagnosticsCommand}"><StackPanel Orientation="Horizontal"><Image Source="/Assets/icons/btn_history.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="View History" FontSize="17" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource ActionButton}" Margin="5,0,0,0" Command="{Binding RefreshDiagnosticsCommand}"><StackPanel Orientation="Horizontal"><Image Source="/Assets/icons/btn_refresh.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Refresh" FontSize="17" VerticalAlignment="Center"/></StackPanel></Button>
                </UniformGrid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/Assets/icons/dtc_ok.png" Width="62" Height="62" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding HasDtcs}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DtcHeadline}" FontSize="24" FontWeight="SemiBold" Foreground="{Binding DtcStateBrush}"/>
                        <TextBlock Text="{Binding DtcSubtext}" FontSize="14" Margin="0,2,0,0" MaxWidth="260">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><DataTrigger Binding="{Binding HasDtcs}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                    <ItemsControl ItemsSource="{Binding ReadDtcs}" Margin="0,4,0,0" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SmallButton}" Margin="4,2" Foreground="{StaticResource WarnBrush}"
                                        Content="{Binding Code}" ToolTip="{Binding Description}"
                                        Command="{Binding DataContext.OpenDtcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Image Source="/Assets/icons/sec_graph.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Live Graph" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <CheckBox Style="{StaticResource LegendCheck}" Tag="{Binding RpmSeries.Brush}" IsChecked="{Binding RpmSeries.IsVisible}" Margin="0,0,18,0" VerticalAlignment="Center"><TextBlock Text="Engine Speed (rpm)" FontSize="15"/></CheckBox>
                        <CheckBox Style="{StaticResource LegendCheck}" Tag="{Binding CoolantSeries.Brush}" IsChecked="{Binding CoolantSeries.IsVisible}" Margin="0,0,18,0" VerticalAlignment="Center"><TextBlock Text="{Binding CoolantLegendText}" FontSize="15"/></CheckBox>
                        <CheckBox Style="{StaticResource LegendCheck}" Tag="{Binding VoltageSeries.Brush}" IsChecked="{Binding VoltageSeries.IsVisible}" VerticalAlignment="Center"><TextBlock Text="Battery Voltage (V)" FontSize="15"/></CheckBox>
                    </StackPanel>
                </DockPanel>
                <c:TimeSeriesChart x:Name="Chart" MinHeight="120"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6"><Image Source="/Assets/icons/sec_can.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="CAN Bus Monitor (Live)" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <DataGrid ItemsSource="{Binding CanRows}" IsReadOnly="True" FontSize="15" RowHeight="28" VerticalScrollBarVisibility="Hidden" HorizontalGridLinesBrush="Transparent">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1C2A38"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time (ms)" Binding="{Binding TimeMs}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CanText}"></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTextColumn Header="ID (Hex)" Binding="{Binding Id}" Width="86"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CanText}"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="52"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CanText}"></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTextColumn Header="Data (Hex)" Binding="{Binding Data}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CanText}"></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <UniformGrid Grid.Row="3" Grid.ColumnSpan="2" Columns="4" Margin="0,2,0,0">
            <Button Style="{StaticResource LargeButton}" Command="{Binding ConnectCommand}"><StackPanel Orientation="Horizontal"><Image Source="/Assets/icons/btn_play.png" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Connect ECU" FontSize="17" VerticalAlignment="Center"/></StackPanel></Button>
            <Button Style="{StaticResource LargeButton}" Command="{Binding DisconnectCommand}"><StackPanel Orientation="Horizontal"><Image Source="/Assets/icons/btn_stop.png" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Disconnect" FontSize="17" VerticalAlignment="Center"/></StackPanel></Button>
            <Button Style="{StaticResource LargeButton}" Command="{Binding ToggleLoggingCommand}"><StackPanel Orientation="Horizontal"><Image Source="/Assets/icons/btn_log.png" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{Binding LoggingButtonText}" FontSize="17" VerticalAlignment="Center"/></StackPanel></Button>
            <Button Style="{StaticResource LargeButton}" Command="{Binding CreateReportCommand}"><StackPanel Orientation="Horizontal"><Image Source="/Assets/icons/btn_report.png" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Create Report" FontSize="17" VerticalAlignment="Center"/></StackPanel></Button>
        </UniformGrid>
    </Grid>
</UserControl>
