<UserControl x:Class="RAV4ControlStudio.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <c:PageHeader Grid.ColumnSpan="2" Title="OBD2 Connection" Subtitle="Choose how this PC reaches the ELM327 adapter plugged into the car's OBD-II port."/>

        <!-- Connection type tiles -->
        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="3" Margin="2,12,2,8">
            <RadioButton Style="{StaticResource ModeTile}" GroupName="Mode" IsChecked="{Binding IsSerialMode}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE702;" FontSize="26" Margin="0,0,16,0" Foreground="{StaticResource AccentBrush}"/>
                    <StackPanel>
                        <TextBlock Text="Bluetooth / USB" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Serial (COM) link. Pair it in Windows first." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource ModeTile}" GroupName="Mode" IsChecked="{Binding IsWifiMode}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE701;" FontSize="26" Margin="0,0,16,0" Foreground="{StaticResource AccentBrush}"/>
                    <StackPanel>
                        <TextBlock Text="Wi-Fi" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Wi-Fi ELM327 over TCP (192.168.0.10)." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource ModeTile}" GroupName="Mode" IsChecked="{Binding IsDemoMode}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7F4;" FontSize="26" Margin="0,0,16,0" Foreground="{StaticResource GoodBrush}"/>
                    <StackPanel>
                        <TextBlock Text="Demo (simulated ECU)" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Simulated RAV4. No hardware needed." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <!-- Settings for the selected mode -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Connection settings" Style="{StaticResource CardTitle}"/>

                <!-- Bluetooth / USB serial -->
                <StackPanel Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Adapter COM port" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                                  DisplayMemberPath="Label" Padding="8,7"/>
                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Command="{Binding RefreshPortsCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" Margin="0,0,8,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap">
                        Bluetooth adapters are listed with "Bluetooth" in their name. To add one, open Bluetooth settings,
                        pair the ELM327 (PIN is usually 1234 or 0000), then press Refresh.
                    </TextBlock>
                    <Button Style="{StaticResource ActionButton}" Command="{Binding OpenBluetoothSettingsCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE702;" Margin="0,0,8,0"/>
                            <TextBlock Text="Open Bluetooth settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Wi-Fi -->
                <StackPanel Visibility="{Binding IsWifiMode, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Padding="16,7" FontSize="14"
                                Command="{Binding FindAdapterCommand}" Content="Find adapter"/>
                        <ComboBox ItemsSource="{Binding WifiPresets}" SelectedItem="{Binding SelectedPreset}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding FinderStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Adapter IP address" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding WifiHost, UpdateSourceTrigger=PropertyChanged}" Padding="8,7"/>
                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding WifiPort}" Padding="8,7" Width="160" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap">
                        Join the Wi-Fi network the adapter creates (for example "WiFi_OBDII"), then keep this PC on that network while connected.
                    </TextBlock>
                </StackPanel>

                <!-- Demo -->
                <StackPanel Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                        The simulator behaves like a RAV4 with the engine warming up and idling, and answers
                        the same commands a real adapter would. Nothing is sent to a vehicle.
                    </TextBlock>
                    <CheckBox Margin="0,14,0,0" FontSize="15" IsChecked="{Binding SimulateFaults}"
                              Content="Simulate fault codes (P0420 stored, P0301 pending)"/>
                </StackPanel>

                <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}"
                          DisplayMemberPath="Label" Padding="8,7"/>

                <StackPanel Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Baud rate" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaud}" Padding="8,7" Width="200" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource ActionButton}" Command="{Binding ConnectCommand}" Width="190">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" Margin="0,0,10,0"/>
                            <TextBlock Text="Connect ECU" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Command="{Binding DisconnectCommand}" Width="190">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" Margin="0,0,10,0"/>
                            <TextBlock Text="Disconnect" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Session + adapter test -->
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Session" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ConnectionText}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding ConnectionBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Adapter" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding AdapterId}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Text="Protocol" Style="{StaticResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProtocolText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="2" Text="VIN" Style="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VinText}" FontFamily="Consolas"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0" Padding="16,8" FontSize="15"
                                Command="{Binding RunAdapterTestCommand}" Content="Test adapter"/>
                        <TextBlock Text="Adapter test" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding AdapterTestSummary}" Foreground="{Binding AdapterTestBrush}" FontSize="14"
                               TextWrapping="Wrap" Margin="0,8,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding AdapterTestRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}" FontWeight="SemiBold" FontSize="14"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl></ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
