<UserControl x:Class="RAV4ControlStudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RAV4ControlStudio.Controls">
    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA8B6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="6">
        <c:PageHeader DockPanel.Dock="Top" Title="Settings" Subtitle="Everything here is remembered between launches and applies immediately."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Units and connection" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>

                            <TextBlock Text="Units" Style="{StaticResource Lbl}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="Units" Content="Metric (km/h, °C, kPa)" IsChecked="{Binding IsMetric}" FontSize="15" Margin="0,0,24,0"/>
                                <RadioButton GroupName="Units" Content="Imperial (mph, °F, psi)" IsChecked="{Binding IsImperial}" FontSize="15"/>
                            </StackPanel>

                            <TextBlock Text="Default baud rate (serial adapters)" Style="{StaticResource Lbl}"/>
                            <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaud}" Width="220" HorizontalAlignment="Left"/>

                            <TextBlock Text="Default protocol" Style="{StaticResource Lbl}"/>
                            <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}"/>

                            <TextBlock Text="Delay between poll cycles (ms, 0 to 500)" Style="{StaticResource Lbl}"/>
                            <TextBox Text="{Binding PollDelayMs}" Padding="8,7" Width="120" HorizontalAlignment="Left"/>

                            <CheckBox Margin="0,16,0,0" FontSize="15" IsChecked="{Binding AutoReconnect}"
                                      Content="Reconnect automatically if the adapter drops"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Alerts" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                            <CheckBox Margin="0,6,0,0" FontSize="15" IsChecked="{Binding AlertsEnabled}" Content="Show a warning banner when a limit is passed"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Coolant temperature above (°C)" Style="{StaticResource Lbl}" Margin="0,8"/>
                                <TextBox Grid.Column="1" Margin="0,4" Padding="8,6" Text="{Binding AlertCoolantC, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="1" Text="Battery voltage below (V)" Style="{StaticResource Lbl}" Margin="0,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="8,6" Text="{Binding AlertVoltageMin, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Row="2" Text="Engine speed above (rpm)" Style="{StaticResource Lbl}" Margin="0,8"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="8,6" Text="{Binding AlertRpmMax, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Display" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                            <TextBlock Text="Interface size" Style="{StaticResource Lbl}"/>
                            <ComboBox ItemsSource="{Binding UiScaleOptions}" SelectedItem="{Binding SelectedUiScale}" Width="260" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Larger sizes need a bigger window; maximise it if content is cut off."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Vehicle" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                            <TextBlock Text="Active vehicle" Style="{StaticResource Lbl}"/>
                            <ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}"/>
                            <TextBlock Text="Add a vehicle" Style="{StaticResource Lbl}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Command="{Binding AddVehicleCommand}" Content="Add"/>
                                <TextBox Padding="8,7" Text="{Binding NewVehicleName, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap">
                                <Run Text="Logs, reports and the baseline are kept per vehicle in: "/><Run Text="{Binding VehicleFolderText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Phone view" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                            <CheckBox Margin="0,6,0,0" FontSize="15" IsChecked="{Binding RemoteViewEnabled}" Content="Let a phone on the same network watch live data"/>
                            <TextBlock Text="{Binding RemoteViewUrl}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Read-only. The address contains a random code. The phone must be able to reach this PC, so it works when both are on the same network (for example through Ethernet or a shared hotspot), not on the adapter's own Wi-Fi. Windows may ask to allow the app through the firewall."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Laptop bridge" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Text="Use this on the laptop next to the car. RAV4 Bridge shares the adapter chosen on the OBD2 Connection page (Wi-Fi or Bluetooth / USB) with RAV4 Control Studio on another PC on the same network. Read-only: the laptop checks every command."/>
                            <TextBlock Text="Bridge port" Style="{StaticResource Lbl}"/>
                            <TextBox Text="{Binding BridgeListenPort}" Padding="8,7" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Access code" Style="{StaticResource Lbl}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Command="{Binding NewBridgeCodeCommand}" Content="New code"/>
                                <TextBox Text="{Binding BridgeAccessCode, Mode=OneWay}" IsReadOnly="True" Padding="8,7" FontFamily="Consolas"/>
                            </DockPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Command="{Binding SaveBridgeSettingsCommand}" Content="Save bridge settings"/>
                                <Button Style="{StaticResource ActionButton}" Margin="0,0,0,8" Command="{Binding StartBridgeCommand}" Content="Start RAV4 Bridge"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding BridgeStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Files and parameters" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding AppFolderText}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <WrapPanel>
                                <Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Command="{Binding OpenProjectsCommand}" Content="Open data folder"/>
                                <Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Command="{Binding OpenLogsFolderCommand}" Content="Logs"/>
                                <Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Command="{Binding OpenReportsFolderCommand}" Content="Reports"/>
                                <Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Command="{Binding OpenParametersFolderCommand}" Content="Custom parameters..."/>
                                <Button Style="{StaticResource ActionButton}" Margin="0,0,0,8" Command="{Binding ReloadParametersCommand}" Content="Reload parameters"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding CustomParameterStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
